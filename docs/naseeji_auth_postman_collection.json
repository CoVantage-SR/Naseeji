{
  "info": {
    "name": "NASEEJI B2B Marketplace - Auth & Identity Module",
    "description": "Enterprise Postman Collection for NASEEJI Authentication & Identity Module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register Factory",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"01012345678\",\n  \"email\": \"factory.test@naseeji.com\",\n  \"password\": \"Pass@1234\",\n  \"companyName\": \"Al-Mahalla Fine Weaving Co.\",\n  \"factoryType\": \"Weaving\",\n  \"governorate\": \"Gharbia\",\n  \"city\": \"Mahalla\",\n  \"address\": \"Industrial Zone 2\",\n  \"commercialRegistration\": \"10055443\",\n  \"taxNumber\": \"999111222\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/register/factory", "host": ["{{baseUrl}}"], "path": ["auth", "register", "factory"] }
      }
    },
    {
      "name": "2. Register Supplier",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"01198765432\",\n  \"email\": \"supplier.test@naseeji.com\",\n  \"password\": \"Pass@1234\",\n  \"companyName\": \"Nile Yarns & Dyes Trading\",\n  \"supplierCategory\": \"Cotton Yarns\",\n  \"commercialRegistration\": \"20044332\",\n  \"taxNumber\": \"888222111\",\n  \"country\": \"Egypt\",\n  \"governorate\": \"Cairo\",\n  \"address\": \"15 Ramses Street\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/register/supplier", "host": ["{{baseUrl}}"], "path": ["auth", "register", "supplier"] }
      }
    },
    {
      "name": "3. Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
 mode": "raw",
          "raw": "{\n  \"identifier\": \"factory.test@naseeji.com\",\n  \"password\": \"Pass@1234\",\n  \"rememberMe\": true\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      }
    },
    {
      "name": "4. Refresh Token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
      }
    },
    {
      "name": "5. Get Profile (/me)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
      }
    },
    {
      "name": "6. Active Device Sessions",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/auth/sessions", "host": ["{{baseUrl}}"], "path": ["auth", "sessions"] }
      }
    },
    {
      "name": "7. Security Logs",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/auth/security-logs", "host": ["{{baseUrl}}"], "path": ["auth", "security-logs"] }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ]
}

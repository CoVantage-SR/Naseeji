{
  "openapi": "3.0.0",
  "info": {
    "title": "NASEEJI B2B Marketplace - Supplier, Store & Enterprise API",
    "version": "1.0.0",
    "description": "Production-ready Enterprise User Management, Role-Based Access Control (RBAC), Supplier & Store Domain, Identity, Verification, Wallet, and Marketplace APIs for NASEEJI Digital Textile Marketplace."
  },
  "servers": [
    {
      "url": "http://localhost:5000/api/v1",
      "description": "Local Development Server"
    },
    {
      "url": "https://api.naseeji.com/v1",
      "description": "Production Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "FactoryRegisterRequest": {
        "type": "object",
        "required": ["phone", "email", "password", "companyName", "factoryType", "governorate", "city", "address", "commercialRegistration", "taxNumber"],
        "properties": {
          "phone": { "type": "string", "example": "01012345678" },
          "email": { "type": "string", "example": "factory@textile.com" },
          "password": { "type": "string", "example": "Pass@1234" },
          "companyName": { "type": "string", "example": "Al-Nour Weaving & Spinning Factory" },
          "factoryType": { "type": "string", "example": "Weaving & Knitting" },
          "governorate": { "type": "string", "example": "Gharbia" },
          "city": { "type": "string", "example": "Mahalla" },
          "address": { "type": "string", "example": "Industrial Zone Building 4" },
          "commercialRegistration": { "type": "string", "example": "10098765" },
          "taxNumber": { "type": "string", "example": "999888777" },
          "logoUrl": { "type": "string", "example": "https://cdn.naseeji.com/logos/factory1.png" }
        }
      },
      "SupplierRegisterRequest": {
        "type": "object",
        "required": ["phone", "email", "password", "companyName", "supplierCategory", "commercialRegistration", "taxNumber", "governorate", "address"],
        "properties": {
          "phone": { "type": "string", "example": "01198765432" },
          "email": { "type": "string", "example": "supplier@textileyarns.com" },
          "password": { "type": "string", "example": "Supp@1234" },
          "companyName": { "type": "string", "example": "Egyptian Cotton & Yarns Ltd" },
          "supplierCategory": { "type": "string", "example": "Raw Yarns & Dyes" },
          "commercialRegistration": { "type": "string", "example": "20087654" },
          "taxNumber": { "type": "string", "example": "888777666" },
          "country": { "type": "string", "example": "Egypt" },
          "governorate": { "type": "string", "example": "Cairo" },
          "address": { "type": "string", "example": "10 El-Tahrir Sq" }
        }
      },
      "UpdateSupplierProfileRequest": {
        "type": "object",
        "properties": {
          "companyName": { "type": "string", "example": "Naseeji Master Textile Mills" },
          "description": { "type": "string", "example": "Premier Egyptian Cotton Manufacturer" },
          "supplierCategory": { "type": "string", "example": "fabric_manufacturer" },
          "businessType": { "type": "string", "enum": ["manufacturer", "wholesaler", "distributor", "importer", "agent"], "example": "manufacturer" },
          "phone": { "type": "string", "example": "+201000000002" },
          "email": { "type": "string", "example": "supplier@naseeji.com" },
          "governorate": { "type": "string", "example": "Alexandria" },
          "city": { "type": "string", "example": "Alexandria" },
          "address": { "type": "string", "example": "Textile Hub, Zone 2" },
          "website": { "type": "string", "example": "https://naseejitextiles.com" }
        }
      },
      "SubmitVerificationRequest": {
        "type": "object",
        "required": ["commercialRegistration", "taxNumber", "documents"],
        "properties": {
          "commercialRegistration": { "type": "string", "example": "CR-500600700" },
          "taxNumber": { "type": "string", "example": "TAX-400300200" },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "documentType": { "type": "string", "example": "commercial_registration_pdf" },
                "url": { "type": "string", "example": "https://cdn.naseeji.com/docs/cr.pdf" }
              }
            }
          },
          "notes": { "type": "string", "example": "Updated tax card attached" }
        }
      },
      "CreateStoreRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "example": "Naseeji Master Textile Mills Official Store" },
          "description": { "type": "string", "example": "Official Marketplace Store for Premium Egyptian Cotton Fabrics" },
          "logo": { "type": "string", "example": "https://cdn.naseeji.com/stores/logo.png" },
          "coverImage": { "type": "string", "example": "https://cdn.naseeji.com/stores/cover.jpg" },
          "isPublic": { "type": "boolean", "example": true }
        }
      }
    }
  },
  "paths": {
    "/suppliers": {
      "get": {
        "summary": "Public marketplace directory search and list active suppliers",
        "tags": ["Supplier Domain"],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "governorate", "in": "query", "schema": { "type": "string" } },
          { "name": "city", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "Paginated public supplier list" } }
      }
    },
    "/suppliers/me": {
      "get": {
        "summary": "Get authenticated supplier self company profile",
        "tags": ["Supplier Domain"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Private supplier profile" }, "401": { "description": "Unauthorized" } }
      },
      "patch": {
        "summary": "Update authenticated supplier company profile (Whitelisted)",
        "tags": ["Supplier Domain"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateSupplierProfileRequest" } } }
        },
        "responses": { "200": { "description": "Supplier profile updated" }, "400": { "description": "Validation error" } }
      }
    },
    "/suppliers/me/verification": {
      "post": {
        "summary": "Submit or resubmit business verification documents",
        "tags": ["Supplier Verification"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmitVerificationRequest" } } }
        },
        "responses": { "201": { "description": "Verification submitted" } }
      }
    },
    "/suppliers/me/store": {
      "post": {
        "summary": "Create primary store for authenticated supplier",
        "tags": ["Store Domain"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateStoreRequest" } } }
        },
        "responses": { "201": { "description": "Store created successfully" } }
      },
      "get": {
        "summary": "Get authenticated supplier store profile",
        "tags": ["Store Domain"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Supplier store" } }
      }
    },
    "/stores/{slug}": {
      "get": {
        "summary": "Public marketplace store details by unique slug",
        "tags": ["Store Domain"],
        "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Public store representation" }, "404": { "description": "Store not found" } }
      }
    }
  }
}

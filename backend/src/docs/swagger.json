{
  "openapi": "3.0.0",
  "info": {
    "title": "NASEEJI B2B Marketplace - User Management, RBAC & Authentication API",
    "version": "1.0.0",
    "description": "Production-ready Enterprise User Management, Role-Based Access Control (RBAC), Permission Matrix, Employee Management, Identity, Verification, Wallet, and Session Management API for NASEEJI Digital Textile Marketplace."
  },
  "servers": [
    {
      "url": "http://localhost:5000/api/v1",
      "description": "Local Development Server"
    },
    {
      "url": "https://api.naseeji.com/v1",
      "description": "Production Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "FactoryRegisterRequest": {
        "type": "object",
        "required": ["phone", "email", "password", "companyName", "factoryType", "governorate", "city", "address", "commercialRegistration", "taxNumber"],
        "properties": {
          "phone": { "type": "string", "example": "01012345678" },
          "email": { "type": "string", "example": "factory@textile.com" },
          "password": { "type": "string", "example": "Pass@1234" },
          "companyName": { "type": "string", "example": "Al-Nour Weaving & Spinning Factory" },
          "factoryType": { "type": "string", "example": "Weaving & Knitting" },
          "governorate": { "type": "string", "example": "Gharbia" },
          "city": { "type": "string", "example": "Mahalla" },
          "address": { "type": "string", "example": "Industrial Zone Building 4" },
          "commercialRegistration": { "type": "string", "example": "10098765" },
          "taxNumber": { "type": "string", "example": "999888777" },
          "logoUrl": { "type": "string", "example": "https://cdn.naseeji.com/logos/factory1.png" }
        }
      },
      "SupplierRegisterRequest": {
        "type": "object",
        "required": ["phone", "email", "password", "companyName", "supplierCategory", "commercialRegistration", "taxNumber", "governorate", "address"],
        "properties": {
          "phone": { "type": "string", "example": "01198765432" },
          "email": { "type": "string", "example": "supplier@textileyarns.com" },
          "password": { "type": "string", "example": "Supp@1234" },
          "companyName": { "type": "string", "example": "Egyptian Cotton & Yarns Ltd" },
          "supplierCategory": { "type": "string", "example": "Raw Yarns & Dyes" },
          "commercialRegistration": { "type": "string", "example": "20087654" },
          "taxNumber": { "type": "string", "example": "888777666" },
          "country": { "type": "string", "example": "Egypt" },
          "governorate": { "type": "string", "example": "Cairo" },
          "address": { "type": "string", "example": "10 El-Tahrir Sq" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["identifier", "password"],
        "properties": {
          "identifier": { "type": "string", "example": "factory@textile.com" },
          "password": { "type": "string", "example": "Pass@1234" },
          "rememberMe": { "type": "boolean", "example": true }
        }
      },
      "UpdateMeRequest": {
        "type": "object",
        "properties": {
          "phone": { "type": "string", "example": "+201000000001" },
          "email": { "type": "string", "example": "updated@factory.com" },
          "companyName": { "type": "string", "example": "Updated Textile Mill" },
          "governorate": { "type": "string", "example": "Cairo" },
          "city": { "type": "string", "example": "New Cairo" },
          "address": { "type": "string", "example": "Industrial Zone 2" }
        }
      },
      "CreateEmployeeRequest": {
        "type": "object",
        "required": ["fullName", "email", "phone"],
        "properties": {
          "fullName": { "type": "string", "example": "Ahmed Procurement Manager" },
          "email": { "type": "string", "example": "ahmed.procurement@factory.com" },
          "phone": { "type": "string", "example": "+201099887766" },
          "password": { "type": "string", "example": "Employee@123" },
          "position": { "type": "string", "example": "Procurement Manager" },
          "role": { "type": "string", "example": "employee" },
          "permissions": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["rfq.create", "rfq.read", "orders.read"]
          }
        }
      },
      "CreateRoleRequest": {
        "type": "object",
        "required": ["code", "name"],
        "properties": {
          "code": { "type": "string", "example": "PROCUREMENT_MANAGER" },
          "name": { "type": "string", "example": "Procurement Manager" },
          "description": { "type": "string", "example": "Manages RFQs and purchase orders" },
          "permissionCodes": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["rfq.create", "rfq.read", "orders.create", "orders.read"]
          }
        }
      },
      "UpdateUserStatusRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["active", "pending", "deactivated", "deleted", "suspended", "blocked", "rejected"],
            "example": "suspended"
          },
          "reason": { "type": "string", "example": "Violation of marketplace terms" }
        }
      }
    }
  },
  "paths": {
    "/users/me": {
      "get": {
        "summary": "Get current authenticated user profile, organization, wallet & permissions",
        "tags": ["User Profile"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "User profile details" }, "401": { "description": "Unauthenticated" } }
      },
      "patch": {
        "summary": "Update current authenticated user profile (whitelisted attributes only)",
        "tags": ["User Profile"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateMeRequest" } } }
        },
        "responses": { "200": { "description": "Profile updated successfully" }, "400": { "description": "Invalid input or restricted field modification attempt" } }
      }
    },
    "/users": {
      "get": {
        "summary": "Admin list & search users with filtering and pagination",
        "tags": ["Admin User Management"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "role", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "Paginated user list" }, "403": { "description": "Forbidden" } }
      }
    },
    "/users/{id}/status": {
      "patch": {
        "summary": "Admin transition user account status (active, suspended, blocked, etc.)",
        "tags": ["Admin User Management"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateUserStatusRequest" } } }
        },
        "responses": { "200": { "description": "Status updated successfully" }, "403": { "description": "Forbidden" } }
      }
    },
    "/employees": {
      "get": {
        "summary": "List employees within current organization boundary",
        "tags": ["Employee Management"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Organization employees" } }
      },
      "post": {
        "summary": "Create new employee bound to organization context",
        "tags": ["Employee Management"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateEmployeeRequest" } } }
        },
        "responses": { "201": { "description": "Employee created successfully" } }
      }
    },
    "/roles": {
      "get": {
        "summary": "List all system and custom RBAC roles",
        "tags": ["Roles & Permissions"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Role list" } }
      },
      "post": {
        "summary": "Create custom RBAC role",
        "tags": ["Roles & Permissions"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateRoleRequest" } } }
        },
        "responses": { "201": { "description": "Role created successfully" } }
      }
    },
    "/permissions": {
      "get": {
        "summary": "List all standard system permissions",
        "tags": ["Roles & Permissions"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Permission list" } }
      }
    }
  }
}

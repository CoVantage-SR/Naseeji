NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Configuration (Container Service / Host access)
MONGODB_URI=mongodb://admin:admin123@mongodb:27017/naseeji?authSource=admin
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=20

# Redis Cache Configuration
REDIS_URL=redis://:redis123@redis:6379

# MinIO S3 Object Storage Configuration
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=naseeji-uploads

# JWT Security Secrets
JWT_SECRET=naseeji-enterprise-super-secret-jwt-key-2026
JWT_REFRESH_SECRET=naseeji-enterprise-super-secret-refresh-key-2026

# System & CORS Configuration
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000/api/v1
LOG_LEVEL=info
LOG_DIR=logs
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
